# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT configuration
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRY=24h

# URLs
# BASE_URL is where the backend is reachable (for Google OAuth redirect)
BASE_URL=http://localhost:8080
# FRONTEND_URL is where the React app is served (for CORS and post-login redirect)
FRONTEND_URL=http://localhost:80

# Database (override only if needed; default is /app/data/workouts.db in container)
# DATABASE_PATH=/app/data/workouts.db
